#!/bin/bash
# Applies MASQUERADE + DNAT rules for WireGuard VPN traffic.
# Called by wireguard-firewall.service after wg-quick@wg0 brings up the tunnel.
#
# DNAT_TARGET is read from /etc/wireguard/firewall.env (set by wireguard_configure).
# Falls back to the default gateway if the file doesn't exist.
# LOCAL_VPN_IP restricts DNAT to traffic addressed to this node only,
# preventing the hub from intercepting transit traffic for other peers.

set -uo pipefail

sysctl -w net.ipv4.ip_forward=1 >/dev/null

if [ -f /etc/wireguard/firewall.env ]; then
  . /etc/wireguard/firewall.env
fi

TARGET="${DNAT_TARGET:-$(ip route show default | awk '{print $3}' | head -1)}"
[ -z "$TARGET" ] && exit 0

LOCAL_VPN_IP=$(ip -4 addr show wg0 2>/dev/null | awk '/inet /{sub(/\/.*/, "", $2); print $2}')
[ -z "$LOCAL_VPN_IP" ] && exit 0

iptables -t nat -C POSTROUTING -o eth0 -j MASQUERADE 2>/dev/null || \
  iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE

# MASQUERADE outbound VPN traffic so containers behind the NAT bridge
# can reach remote VPN peers. Without this, replies can't route back
# (source stays as 10.99.x.20 which is unreachable from remote peers).
iptables -t nat -C POSTROUTING -o wg0 -j MASQUERADE 2>/dev/null || \
  iptables -t nat -A POSTROUTING -o wg0 -j MASQUERADE

# Allow forwarding from the local bridge (eth0) to the VPN tunnel (wg0).
# Host routes 10.0.0.0/24 via this container; this FORWARD rule lets
# container-originated traffic traverse the tunnel.
iptables -C FORWARD -i eth0 -o wg0 -j ACCEPT 2>/dev/null || \
  iptables -A FORWARD -i eth0 -o wg0 -j ACCEPT

for PORT in 6080 6081 6082 6083 9001; do
  iptables -t nat -C PREROUTING -i wg0 -d "$LOCAL_VPN_IP" -p tcp --dport "$PORT" \
    -j DNAT --to-destination "$TARGET:$PORT" 2>/dev/null || \
    iptables -t nat -A PREROUTING -i wg0 -d "$LOCAL_VPN_IP" -p tcp --dport "$PORT" \
      -j DNAT --to-destination "$TARGET:$PORT"

  iptables -C FORWARD -i wg0 -d "$TARGET" -p tcp --dport "$PORT" \
    -j ACCEPT 2>/dev/null || \
    iptables -A FORWARD -i wg0 -d "$TARGET" -p tcp --dport "$PORT" \
      -j ACCEPT
done

netfilter-persistent save 2>/dev/null || true
