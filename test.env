PRIMARY_HOST=192.168.86.201
AI_HOST=192.168.86.220
MESH_2_HOST=192.168.86.211
BRIDGE_1_HOST=192.168.86.230
BRIDGE_2_HOST=192.168.86.231
MESH_KEY=test-mesh-passphrase
WAN_MAC=08:B4:B1:1A:63:08
PIHOLE_WEB_PASSWORD=testpihole123

# Gaming VM (Sunshine host)
GAMING_VM_ADMIN_USER=admin
GAMING_VM_ADMIN_PASSWORD=Passw0rd!
SUNSHINE_USER=admin
SUNSHINE_PASSWORD=sunshine123

# Moonlight streaming client
MOONLIGHT_SERVER_IP=192.168.86.220
MOONLIGHT_PAIR_PIN=1234

# Desktop LXC
DESKTOP_USER=testdesktop
DESKTOP_PASSWORD=testdesktop

# Web UI / API port (must be open in firewall)
WEBUI_PORT=52525

# Kiosk Manager port (per-host Manager listens on this inside the container)
KIOSK_MANAGER_PORT=9001

# Call-home fleet management
# PRIVATE_KEY stays on the management server; PUBLIC_KEY goes to every node.
# Nodes present the public key; server validates via HMAC derivation.
CALLHOME_SERVER=
CALLHOME_PRIVATE_KEY=fd485af7b005c853464a61f1de43b6cb37855868e4dc997f52dd3483305cf422
CALLHOME_PUBLIC_KEY=3e2304fdaea150920e92ecd02aa448d1024ada040092c79d16a4ef5694d1c27d

# VPN IPs — static per-host, used by SM to resolve display URLs
HOME_VPN_IP=10.0.0.1
MESH_1_VPN_IP=10.0.0.2
AI_VPN_IP=10.0.0.3
MESH_2_VPN_IP=10.0.0.4
BRIDGE_1_VPN_IP=10.0.0.5
BRIDGE_2_VPN_IP=10.0.0.6

# WireGuard hub-spoke VPN — home's WG container is the hub
WIREGUARD_SERVER_ENDPOINT=192.168.86.201:51820
CONTROLLER_VPN_IP=10.0.0.7

# Per-host API tokens: <HOSTNAME>_API_TOKEN
# Convention: inventory_hostname uppercased + _API_TOKEN
# Create on each node: pveum user token add root@pam ansible --privsep=0
HOME_API_TOKEN=cab59c9a-c517-4033-a31e-8b332a24f391
MESH1_API_TOKEN=e461164e-2a07-43e3-899d-fb6f0fd64276
