# Home Assistant Configuration
# Generated by Ansible role homeassistant_configure

# Basic Configuration
default_config:

# HTTP Configuration
http:
  server_port: 8123
  ip_ban_enabled: true
  login_attempts_threshold: 5
  use_x_forwarded_for: true
  trusted_proxies:
    - 127.0.0.1
    - ::1

# Recorder Configuration
recorder:
  db_url: {{ homeassistant_recorder_db_url }}
  purge_keep_days: {{ homeassistant_recorder_purge_days }}
  exclude:
    entities:
      - sensor.date
      - sensor.time
      - sun.sun
    domains:
      - updater

# Logger Configuration
logger:
  default: {{ homeassistant_log_level }}
  logs:
    # Suppress verbose logs for common components
    homeassistant.core: WARNING
    homeassistant.components.recorder: WARNING
    homeassistant.components.http: WARNING

# Discovery Configuration
discovery:

# Input Boolean/Text/Select (for automations)
input_boolean:
input_text:
input_select:

# Automation Configuration
automation:
  - id: 'ha_configured_initial'
    alias: Home Assistant Initial Configuration
    description: Initial setup tasks
    trigger:
      - platform: homeassistant
        event: start
    condition: []
    action:
      - service: persistent_notification.create
        data:
          title: Home Assistant Configured
          message: >
            Home Assistant has been successfully configured via Ansible.
            Admin credentials have been set.
            Web UI: http://{{ ansible_host | default('localhost') }}:8123

# Script Configuration
script:

# Scene Configuration
scene: