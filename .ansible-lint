---
profile: production

# ansible-lint resolves {{ playbook_dir }}/../tasks/ as role-relative at
# lint time, producing phantom paths like roles/*/tasks/manager_register.yml.
# The real files live at tasks/ and work at runtime.
exclude_paths:
  - .venv/
  - collections/
  - molecule/
  - scripts/.image-builder-cache/
  - roles/*/tasks/manager_register.yml
  - roles/*/tasks/resolve_deployed_version.yml
  - roles/*/tasks/resolve_kiosk_version.yml

skip_list:
  - command-instead-of-module
  - no-changed-when
  - risky-shell-pipe
  - var-naming[no-role-prefix]

mock_roles:
  - deploy_stamp
